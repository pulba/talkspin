---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import SpinWheel from "../components/SpinWheel.astro";
import ChallengeModal from "../components/ChallengeModal.astro";
---

<Layout title="TalkSpin — Spin. Think. Speak.">
  <main
    class="h-screen w-full flex flex-col justify-center items-center px-4 bg-background overflow-hidden"
  >
    <!-- Direct Wheel Focus (Clean, No Clutter) -->
    <div class="flex items-center justify-center">
      <SpinWheel />
    </div>

    <!-- Copyright -->
    <div class="absolute bottom-4 text-center text-xs text-muted font-medium w-full z-10 pointer-events-auto">
      &copy; {new Date().getFullYear()} <a href="https://pulba.eu.org/" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">PulbaDigital</a>
    </div>
  </main>

  <!-- Single Screen Popup Modal -->
  <ChallengeModal />
</Layout>
